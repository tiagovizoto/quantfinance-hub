# Copie para .env e preencha. NUNCA versione o .env.
DATABASE_URL=sqlite+aiosqlite:///./quantfinance.db
SQL_ECHO=false

# Credenciais da aplicação criada em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# itemId(s) gerado(s) no Pluggy Connect. No MeuPluggy cada banco conectado é UM item:
# liste todos separados por vírgula (ex.: PLUGGY_ITEM_ID=id-nubank,id-itau,id-inter)
PLUGGY_ITEM_ID=
